# =============================================================================
# Preciso de Um Técnico — variáveis de ambiente (exemplo)
# Copie para `.env` e ajuste. Nunca commite o `.env` real.
# =============================================================================

# --- Backend (cliente / browser) --------------------------------------------
# Ao rodar o Supabase local (`supabase start`), use os valores impressos no
# terminal pelo próprio CLI.
VITE_SUPABASE_URL="http://127.0.0.1:54321"
VITE_SUPABASE_PUBLISHABLE_KEY="<anon key impressa por `supabase start`>"
VITE_SUPABASE_PROJECT_ID="local"

# --- Backend (servidor / server functions) ----------------------------------
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_PUBLISHABLE_KEY="<anon key impressa por `supabase start`>"
SUPABASE_SERVICE_ROLE_KEY="<service_role key impressa por `supabase start`>"

# --- Integrações externas ---------------------------------------------------
# Em desenvolvimento, mantenha MOCK_EXTERNAL_APIS=true: e-mails (Resend) e
# notificações (CallMeBot) apenas registram log em vez de sair para a internet.
MOCK_EXTERNAL_APIS="true"
RESEND_API_KEY=""
CALLMEBOT_API_KEY=""
CALLMEBOT_PHONE=""

# --- Observabilidade (opcional) ---------------------------------------------
VITE_SENTRY_DSN=""
